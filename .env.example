# =============================================================
# Socrates-Cube 环境变量模板
# 使用前：cp .env.example .env  然后填入真实值
# 警告：.env 文件已加入 .gitignore，禁止提交到版本控制！
# =============================================================

# ──────────────────────────────────────────────────────────────
# JWT 鉴权（M1 auth.py）
# ──────────────────────────────────────────────────────────────
# 用于签发/验证 JWT Token，务必设置足够长的随机字符串（至少32位）
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ──────────────────────────────────────────────────────────────
# 讯飞星火 API（默认 LLM + TTS + 数字人）
# ──────────────────────────────────────────────────────────────
XUNFEI_APP_ID=your_app_id_here
XUNFEI_API_KEY=your_api_key_here
XUNFEI_API_SECRET=your_api_secret_here
XUNFEI_SPARK_URL=wss://spark-api.xf-yun.com/v3.5/chat

# 讯飞 TTS（文字转语音）
XUNFEI_TTS_URL=wss://tts-api.xf-yun.com/v2/tts

# ──────────────────────────────────────────────────────────────
# OpenAI 兼容接口（M2 多人格路由：SkyClaw / Qwen / DeepSeek 等）
# 接口兼容 OpenAI SDK，只需修改 base_url 即可接入各厂商
# ──────────────────────────────────────────────────────────────
# SkyClaw（免费试用额度，apifree.ai）
# OPENAI_COMPAT_BASE_URL=https://apifree.ai/v1
# OPENAI_COMPAT_API_KEY=your_skyclaw_key_here
# OPENAI_COMPAT_MODEL=skyclaw-v1-lite

# Qwen（阿里云，推荐生产用）
# OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPAT_API_KEY=your_qwen_key_here
# OPENAI_COMPAT_MODEL=qwen-plus

# DeepSeek
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPAT_API_KEY=your_deepseek_key_here
# OPENAI_COMPAT_MODEL=deepseek-chat

# GLM-4 (智谱AI · 源自清华大学KEG实验室 ChatGLM 开源血脉)
# 参考：清华大学 KEG 实验室 ChatGLM 开源研究 → https://github.com/THUDM/ChatGLM3
# 商业接口文档：https://open.bigmodel.cn/dev/api
# OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_COMPAT_API_KEY=your_zhipu_key_here
# OPENAI_COMPAT_MODEL=glm-4-flash   # 免费额度；glm-4 / glm-4-air 为付费高性能版

# 最终生效的配置（取消注释并填入对应值）
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ──────────────────────────────────────────────────────────────
# 数据库（默认 SQLite，生产可替换为 PostgreSQL）
# ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./edu_agent.db
# PostgreSQL 示例（可扩展）：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edu_agent

# ──────────────────────────────────────────────────────────────
# 向量库路径
# ──────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ──────────────────────────────────────────────────────────────
# 服务配置
# ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ──────────────────────────────────────────────────────────────
# 多模态信息图生成（SenseNova-U1）
# OpenSenseNova 开源参考：https://github.com/OpenSenseNova/SenseNova-U1
# 最新模型：SenseNova-U1-8B-MoT-Infographic-V3（2026-07-16）
#   - 支持密集信息图生成+编辑、局部文字/内容/版式编辑
#   - 开源 SoTA：联合理解+生成基准领先同类开源模型
# 获取 API Key：https://platform.sensenova.cn/
# 未配置时自动降级为 LLM 结构化输出 + 前端 SVG 渲染
# ──────────────────────────────────────────────────────────────
SENSENOVA_API_KEY=
SENOVAU1_API_KEY=
SENOVAU1_BASE_URL=https://api.sensecore.cn/v1
# 覆盖信息图模型版本（默认最新 V3）
# SENOVAU1_MODEL=SenseNova-U1-8B-MoT-Infographic-V3

# ──────────────────────────────────────────────────────────────
# PDF 高精度解析（MinerU / magic-pdf）
# 开源仓库：https://github.com/opendatalab/MinerU
# 配套数据加载：https://github.com/opendatalab/opendatalab-pdf
# 安装：pip install magic-pdf[full] --cache-dir D:\pip-cache
# 未安装时自动降级为 PyMuPDF （所有功能仍可用）
# ──────────────────────────────────────────────────────────────
# MAGIC_PDF_MODEL_DIR=D:\models\mineru    # 模型文件存放到 D 盘（请勿占用 C 盘！）
MAGIC_PDF_MODEL_DIR=D:\models\mineru

# ──────────────────────────────────────────────────────────────
# 多智能体教学架构参考（OpenMAIC）
# 清华大学 MAIC 实验室开源多智能体协同教学平台
# 参考：https://github.com/THU-MAIC/OpenMAIC
# 本项目 Agent 架构（Orchestrator + 专业Agent + 认知单元建模）间接参考该项目理念

# CORS（开发阶段允许所有来源，生产阶段改为具体域名）
# 支持三种格式：
#   - * → 允许所有来源（仅开发/Mock 模式）
#   - 逗号分隔字符串：http://yourdomain.com,https://yourdomain.com
#   - JSON 数组字符串：["http://yourdomain.com","https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ALLOWED_ORIGINS=*

# 安全加盐配置
# 密码哈希加盐：不低于 32 位的随机字符串
PWD_SALT=change-me-to-a-random-string-at-least-32-chars
# AES 加密密钥（将自动截取前 32 位）
DATA_ENCRYPT_KEY=change-me-to-a-random-aes256-key-here!

# ──────────────────────────────────────────────────────────────
# MinerU 高精度 PDF 解析（MCP Server + REST API）
# GitHub:  https://github.com/opendatalab/MinerU  (v3.4+, 2026-06-18)
# MCP 安装: uvx mineru-mcp  (Cursor/Claude Desktop 可直接使用)
# VLM+OCR 双引擎，公式→LaTeX，表格→HTML，109种语言，hybrid 后端在 Windows 快 90%
# REST API：无需本地模型，直接调用 mineru.net 云端
# ──────────────────────────────────────────────────────────────
MINERU_API_KEY=
# MINERU_API_KEY=mnu-xxxxxxxxxxxxxxxxxxxxxxxx
MINERU_API_URL=https://api.mineru.net/v1

# ──────────────────────────────────────────────────────────────
# SenseNova-U1 信息图生成（统一多模态模型）
# GitHub: https://github.com/OpenSenseNova/SenseNova-U1
# 模型: SenseNova-U1-8B-MoT-Infographic-V3（局部文字+布局编辑，2026-07-16）
# 获取方式: https://sensenova.cn/ -> 控制台 -> API Keys
# 注：已在上方配置。这里仅保留注释说明。
# ──────────────────────────────────────────────────────────────
# SENSENOVA_API_KEY 已在上方 L85 配置，此处不再重复

