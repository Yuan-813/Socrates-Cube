# 前端环境变量配置
# 复制本文件为 .env 后填入实际值

# API 基础地址（开发时留空走 Vite 代理，生产时替换为部署地址）
# 示例：http://localhost:8000
VITE_API_BASE_URL=

# SSE 流式对话端点（开发默认走 Vite 代理；生产时如需覆盖可显式指定）
VITE_SSE_ENDPOINT=/api/v1/chat/stream

# Mock 模式（设为 true 时前端拦截 API 并返回本地 Mock 数据）
# 也可直接运行: npm run dev:mock
VITE_MOCK_MODE=false

# Mock 模式（设为 true 时前端拦截 API 并返回本地数据；或使用 npm run dev:mock）
# VITE_MOCK_MODE=true
